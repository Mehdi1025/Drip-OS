NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only — webhooks & admin operations
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Notifications > Webhooks (signature en bas de page) OU Client secret app Dev
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-signing-secret

# true = chaque line_item crée un skin (boutique 100 % vinyles)
# SHOPIFY_IMPORT_ALL_LINE_ITEMS=true

# Expédition scanner → fulfillment Shopify (app custom Admin API)
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
# SHOPIFY_API_VERSION=2024-10
# Transporteur par défaut si le mode d'envoi commande n'est pas reconnu
# SHOPIFY_DEFAULT_TRACKING_COMPANY=Colissimo
# true = envoie le track_code Drip OS comme n° de suivi Shopify (sinon : expédié sans suivi)
# SHOPIFY_FULFILLMENT_USE_TRACK_CODE=false

# Backfill shopify_line_item_id (POST /api/admin/backfill-shopify-line-items, Bearer token)
# DRIP_ADMIN_SECRET=long-random-secret

# Smart Restock — alertes stock bas (Discord webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
